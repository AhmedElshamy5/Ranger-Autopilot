# hw definition file for processing by chibios_hwdef.py
# Ranger FC A0.1 bootloader - STM32H743VIT6
#
# RANGER-DEVELOPED FILE (GPLv3, same licence as ArduPilot).
#
# STATUS: AS-DESIGNED, never run on hardware. This is the ArduPilot
# bootloader, which must itself be programmed once over SWD. Loading it
# through the ST ROM DFU (BOOT0 + USB) is expected to work but is
# unconfirmed on this board.

# MCU class and specific type
MCU STM32H7xx STM32H743xx

# Ranger-local board ID, NOT allocated by ArduPilot upstream
APJ_BOARD_ID AP_HW_RANGERH743

# 8 MHz HSE crystal
OSCILLATOR_HZ 8000000

FLASH_SIZE_KB 2048

# bootloader starts at zero offset
FLASH_RESERVE_START_KB 0

# the location where the bootloader will put the firmware
# (the H743 has 128k sectors)
FLASH_BOOTLOADER_LOAD_KB 128

# bootloading is offered on USB and on J_TELEM1
SERIAL_ORDER OTG1 USART2

PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1
PA9 VBUS INPUT

PD5 USART2_TX USART2 NODMA
PD6 USART2_RX USART2 NODMA

PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

# LEDs are active low
PE15 LED_BOOTLOADER OUTPUT HIGH
PD7 LED_ACTIVITY OUTPUT HIGH
define HAL_LED_ON 0

# keep the sensor rail on and every chip select high in the bootloader
PB12 VDD_3V3_SENSORS_EN OUTPUT HIGH
PA4 ICM42688_CS CS
PD10 BMI088_A_CS CS
PD11 BMI088_G_CS CS
PE4 FLOW_CS CS

# keep the CAN transceiver in standby while in the bootloader
PC13 GPIO_CAN1_SILENT OUTPUT PUSHPULL SPEED_LOW HIGH
